// Version information and manifest shared by the Windows executables (the game, its installer and
// uninstaller): define VER_DESC and VER_NAME (the file's name) before including this.
#include <winver.h>

1 24 "res/app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Carlos Ramirez"
      VALUE "FileDescription", VER_DESC
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", VER_NAME
      VALUE "LegalCopyright", "MIT License. Source: github.com/carlosrmz009/littleplanet"
      VALUE "OriginalFilename", VER_NAME
      VALUE "ProductName", "Little Planet"
      VALUE "ProductVersion", "1.0"
      VALUE "Comments", "Open source Sonic CD decompilation and PC port. Built by GitHub Actions from the public source."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
